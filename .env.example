# Copy to .env for npm run analyze. npm start -- --offline does not require this file.
# Live analyze loads .env in code. Shell variables override values from the file.

# Default analyst roster when --handles is omitted
ANALYST_LIST_PATH=config/analysts.json

# Post retrieval: desearch for live analyze; mock is only for --offline and tests
POSTS_PROVIDER=desearch

DESEARCH_API_KEY=replace_me_only_when_you_are_ready
DESEARCH_LIVE_ENABLED=true
# Optional override; preflight shows origin only. Non-default hosts must use https unless localhost or 127.0.0.1.
# DESEARCH_API_BASE=https://api.desearch.ai

DESEARCH_MAX_REQUESTS_PER_RUN=5
DESEARCH_MAX_REQUESTS_PER_HANDLE=3
LOOKBACK_DAYS=30

MAX_POSTS_PER_PERSON=10
MAX_POSTS_TOTAL=25

LLM_INPUT_MAX_CHARS=20000

ANALYSIS_PROVIDER=chutes
LLM_LIVE_ENABLED=true
CHUTES_API_KEY=replace_me_only_when_you_are_ready
# Optional override; same preflight origin and HTTPS rules as DESEARCH_API_BASE.
# CHUTES_CHAT_COMPLETIONS_URL=https://llm.chutes.ai/v1/chat/completions
LLM_MODEL=Qwen/Qwen3-32B-TEE

# Optional: alternate directory for the pinned tokenizer files (same checksums required)
# LLM_TOKENIZER_DIR=vendor/qwen3-32b-fp8
