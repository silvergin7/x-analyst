# Copy to .env for npm run analyze. npm start -- --offline does not require this file.

# Live analyze loads this file in code (the npm script does not pass --env-file).

# Default analyst roster for npm run analyze when --handles is omitted
ANALYST_LIST_PATH=config/analysts.json

# Post retrieval provider: mock (default) or desearch
POSTS_PROVIDER=mock

# Desearch — placeholders only; do not commit real keys
DESEARCH_API_KEY=replace_me_only_when_you_are_ready
# DESEARCH_API_BASE=https://api.desearch.ai

# Must be true AND provider=desearch AND a real key before live Desearch fetch is allowed
DESEARCH_LIVE_ENABLED=false

# Fixture retrieval caps. Desearch stops on LOOKBACK_DAYS or the request limit, not these counts.
MAX_POSTS_PER_PERSON=10
MAX_POSTS_TOTAL=25

# Max Desearch HTTP requests per fetch run (pagination pages). Not a dollar cap.
# This is the hard stop for the whole run. A post count does not stop a further page.
DESEARCH_MAX_REQUESTS_PER_RUN=5

# Required before a live Desearch fetch. A positive integer. Not a dollar cap.
# Mock runs and --replay do not need it. Unset, empty, or malformed stops a live
# fetch before any request. Each handle stops at the lower of this cap and the
# run budget still remaining. The report names which limit stopped it.
DESEARCH_MAX_REQUESTS_PER_HANDLE=3

# Days before the analysis reference date to keep requesting pages. Default 30.
LOOKBACK_DAYS=30

# Total characters of eligible post text sent to the model. Default 20000.
# Each post is still cut at 1000 characters. The local $0.05 check uses this payload.
LLM_INPUT_MAX_CHARS=20000

# Outlook analysis: mock (default) or chutes.
# npm start, the API, and the web UI call Chutes when ANALYSIS_PROVIDER=chutes,
# LLM_LIVE_ENABLED=true, a real CHUTES_API_KEY, and LLM_MODEL=Qwen/Qwen3-32B-TEE.
# Otherwise they stay on the mock analyzer.
ANALYSIS_PROVIDER=mock

# The same gates allow npm run analyze:llm-fixture to call Chutes.
LLM_LIVE_ENABLED=false

# Chutes — placeholder only; do not commit a real key
CHUTES_API_KEY=replace_me_only_when_you_are_ready
# CHUTES_CHAT_COMPLETIONS_URL=https://llm.chutes.ai/v1/chat/completions

# Priced model for the local $0.05 fixture-call budget. A different model needs a new estimate.
LLM_MODEL=Qwen/Qwen3-32B-TEE
