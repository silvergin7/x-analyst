# Copy to .env only when you are ready for live services (not required for mock CLI).

# Post retrieval provider: mock (default) or desearch
POSTS_PROVIDER=mock

# Desearch — placeholders only; do not commit real keys
DESEARCH_API_KEY=replace_me_only_when_you_are_ready

# Must be true AND provider=desearch AND a real key before live Desearch fetch is allowed
DESEARCH_LIVE_ENABLED=false

# Conservative fetch caps (positive whole integers) — posts retained for analysis, not API spend
MAX_POSTS_PER_PERSON=10
MAX_POSTS_TOTAL=25

# Max Desearch HTTP requests per fetch run (pagination pages). Not a dollar cap.
DESEARCH_MAX_REQUESTS_PER_RUN=5

# Outlook analysis: mock (default) or chutes.
# npm start, the API, and the web UI ignore these and keep the mock analyzer.
ANALYSIS_PROVIDER=mock

# Must be true AND provider=chutes AND a real key AND LLM_MODEL=Qwen/Qwen3-32B-TEE
# before npm run analyze:llm-fixture is allowed to call Chutes.
LLM_LIVE_ENABLED=false

# Chutes — placeholder only; do not commit a real key
CHUTES_API_KEY=replace_me_only_when_you_are_ready

# Priced model for the local $0.05 fixture-call budget. A different model needs a new estimate.
LLM_MODEL=Qwen/Qwen3-32B-TEE
