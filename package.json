{
  "name": "x-analyst",
  "version": "0.1.0",
  "private": true,
  "description": "Local macro-analyst outlook prototype (mocked CLI)",
  "type": "module",
  "scripts": {
    "start": "tsx src/cli.ts",
    "analyze": "tsx src/analyzeCli.ts",
    "analyze:llm-fixture": "tsx src/llmFixtureCheck.ts",
    "dev:server": "tsx server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "node --import tsx test/dataDirSnapshotStart.ts && node --import tsx --import ./test/testEnvBootstrap.ts --test test/*.test.ts test/desearch/*.test.ts test/format/*.test.ts test/server/*.test.ts && node --import tsx test/dataDirSnapshotEnd.ts && vitest run --config web/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "26.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@huggingface/jinja": "^0.5.10",
    "@huggingface/tokenizers": "^0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
